<UiContainer layout="vertical" alignment="center" width="400" height="450" background="ui/background.png">
    <Label text="§a[ HyAstur Claims - Mapa Interactivo ]" alignment="center" font_size="18" margin="10" />
    
    <!-- Cuadrícula 5x5 de chunks -->
    <!-- Fila -2 -->
    <UiContainer layout="horizontal" alignment="center">
        <Button id="CHUNK_-2_-2" label="$Btn_-2_-2" width="70" height="50" margin="2" />
        <Button id="CHUNK_-1_-2" label="$Btn_-1_-2" width="70" height="50" margin="2" />
        <Button id="CHUNK_0_-2"  label="$Btn_0_-2"  width="70" height="50" margin="2" />
        <Button id="CHUNK_1_-2"  label="$Btn_1_-2"  width="70" height="50" margin="2" />
        <Button id="CHUNK_2_-2"  label="$Btn_2_-2"  width="70" height="50" margin="2" />
    </UiContainer>

    <!-- Fila -1 -->
    <UiContainer layout="horizontal" alignment="center">
        <Button id="CHUNK_-2_-1" label="$Btn_-2_-1" width="70" height="50" margin="2" />
        <Button id="CHUNK_-1_-1" label="$Btn_-1_-1" width="70" height="50" margin="2" />
        <Button id="CHUNK_0_-1"  label="$Btn_0_-1"  width="70" height="50" margin="2" />
        <Button id="CHUNK_1_-1"  label="$Btn_1_-1"  width="70" height="50" margin="2" />
        <Button id="CHUNK_2_-1"  label="$Btn_2_-1"  width="70" height="50" margin="2" />
    </UiContainer>

    <!-- Fila 0 (Centro) -->
    <UiContainer layout="horizontal" alignment="center">
        <Button id="CHUNK_-2_0"  label="$Btn_-2_0"  width="70" height="50" margin="2" />
        <Button id="CHUNK_-1_0"  label="$Btn_-1_0"  width="70" height="50" margin="2" />
        <Button id="CHUNK_0_0"   label="$Btn_0_0"   width="70" height="50" margin="2" />
        <Button id="CHUNK_1_0"   label="$Btn_1_0"   width="70" height="50" margin="2" />
        <Button id="CHUNK_2_0"   label="$Btn_2_0"   width="70" height="50" margin="2" />
    </UiContainer>

    <!-- Fila 1 -->
    <UiContainer layout="horizontal" alignment="center">
        <Button id="CHUNK_-2_1"  label="$Btn_-2_1"  width="70" height="50" margin="2" />
        <Button id="CHUNK_-1_1"  label="$Btn_-1_1"  width="70" height="50" margin="2" />
        <Button id="CHUNK_0_1"   label="$Btn_0_1"   width="70" height="50" margin="2" />
        <Button id="CHUNK_1_1"   label="$Btn_1_1"   width="70" height="50" margin="2" />
        <Button id="CHUNK_2_1"   label="$Btn_2_1"   width="70" height="50" margin="2" />
    </UiContainer>

    <!-- Fila 2 -->
    <UiContainer layout="horizontal" alignment="center">
        <Button id="CHUNK_-2_2"  label="$Btn_-2_2"  width="70" height="50" margin="2" />
        <Button id="CHUNK_-1_2"  label="$Btn_-1_2"  width="70" height="50" margin="2" />
        <Button id="CHUNK_0_2"   label="$Btn_0_2"   width="70" height="50" margin="2" />
        <Button id="CHUNK_1_2"   label="$Btn_1_2"   width="70" height="50" margin="2" />
        <Button id="CHUNK_2_2"   label="$Btn_2_2"   width="70" height="50" margin="2" />
    </UiContainer>

    <!-- Botón de Cierre -->
    <Button id="CLOSE_MAP" label="Cerrar Mapa" width="150" height="35" alignment="center" margin="15" />
</UiContainer>
